{
  "name": "vscode-mcp-server",
  "icon": "media/logo.png",
  "displayName": "vscode-mcp-server",
  "description": "VS Code as a MCP server",
  "version": "0.3.0",
  "repository": "https://github.com/juehang/vscode-mcp-server",
  "publisher": "JuehangQin",
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "MCP Server",
      "properties": {
        "vscode-mcp-server.useUnixSocket": {
          "type": "boolean",
          "default": true,
          "description": "Use Unix domain socket transport instead of HTTP"
        },
        "vscode-mcp-server.socketPath": {
          "type": "string",
          "description": "Override Unix domain socket path (optional, auto-computed if not set)"
        },
        "vscode-mcp-server.port": {
          "type": "number",
          "default": 11331,
          "minimum": 1024,
          "maximum": 65535,
          "description": "The port number for the MCP server (only used when useUnixSocket is false)"
        },
        "vscode-mcp-server.defaultEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether the MCP server should be enabled by default on VS Code startup"
        },
        "vscode-mcp-server.enabledTools": {
          "type": "object",
          "default": {
            "file": true,
            "edit": true,
            "shell": true,
            "diagnostics": true,
            "symbol": true,
            "extension": true,
            "quickfix": true,
            "debug": true,
            "launchConfig": true
          },
          "properties": {
            "file": {
              "type": "boolean",
              "description": "Enable file operations tools (read, write, list files)"
            },
            "edit": {
              "type": "boolean",
              "description": "Enable file editing tools (create, edit, delete files)"
            },
            "shell": {
              "type": "boolean",
              "description": "Enable shell command execution tools"
            },
            "diagnostics": {
              "type": "boolean",
              "description": "Enable VS Code diagnostics tools"
            },
            "symbol": {
              "type": "boolean",
              "description": "Enable code symbol and structure analysis tools"
            },
            "extension": {
              "type": "boolean",
              "description": "Enable VS Code extension management tools"
            },
            "quickfix": {
              "type": "boolean",
              "description": "Enable code quickfix and code action tools"
            },
            "debug": {
              "type": "boolean",
              "description": "Enable debugging tools (breakpoints, debug sessions)"
            },
            "launchConfig": {
              "type": "boolean",
              "description": "Enable launch configuration management tools"
            }
          },
          "description": "Configure which MCP tools are enabled"
        }
      }
    },
    "commands": [
      {
        "command": "vscode-mcp-server.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "vscode-mcp-server.showServerInfo",
        "title": "Show MCP Server Information"
      },
      {
        "command": "vscode-mcp-server.toggleServer",
        "title": "Toggle MCP Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest run src/test.unit --reporter=verbose",
    "test:unit:watch": "vitest watch src/test.unit",
    "test:integration:prepare": "npm run compile && ./scripts/launch-test-env.sh",
    "test:integration:test-only": "vitest run src/test.integration --reporter=verbose --no-coverage --pool=threads --poolOptions.threads.singleThread",
    "test:integration:single": "vitest run --reporter=verbose --no-coverage --pool=threads --poolOptions.threads.singleThread",
    "test:integration": "npm run test:integration:prepare && npm run test:integration:test-only",
    "test:debug-e2e": "npm run test:integration:prepare && vitest run src/test.integration/debug-e2e.test.ts --reporter=verbose --no-coverage",
    "package": "vsce package --dependencies"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "github:modelcontextprotocol/inspector",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/proxyquire": "^1.3.28",
    "@types/sinon": "^10.0.13",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.4.2",
    "eslint": "^9.23.0",
    "mocha": "^11.7.1",
    "proxyquire": "^2.1.3",
    "sinon": "^16.1.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@types/express": "^4.17.21",
    "@vscode/debugprotocol": "^1.68.0",
    "express": "^4.18.3",
    "zod": "^3.22.4"
  }
}
